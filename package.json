{
  "name": "sky-plane",
  "version": "1.0.0",
  "private": true,
  "description": "A portable single-player airport business and flight simulation game.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "dev": "node dev-exe.js",
    "pack": "electron-builder --dir",
    "sync": "node dev-exe.js --sync-once",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.skyplane.game",
    "productName": "Sky Plane",
    "asar": false,
    "files": [
      "index.html",
      "style.css",
      "core.js",
      "worlds.js",
      "cockpit.js",
      "world.js",
      "app.js",
      "main.js"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "SkyPlane.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
